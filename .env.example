# Local PostgreSQL only. Copy to .env and fill locally; never commit the resulting file.
POSTGRES_DB=deanery
POSTGRES_USER=deanery
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
UNIVERSITY_TIME_ZONE=Europe/Moscow
# Production requires a real HTTPS origin and config.settings.production.
CSRF_TRUSTED_ORIGINS=
